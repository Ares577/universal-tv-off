<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/vanta_screen" android:scaleType="fitXY"
        android:contentDescription="VANTA IR Universal Remote" />
    <Button android:id="@+id/offButton" android:layout_width="300dp" android:layout_height="220dp"
        android:layout_gravity="center" android:translationY="112dp"
        android:background="@android:color/transparent" android:text=""
        android:alpha="0.02" android:stateListAnimator="@null" />
    <TextView android:id="@+id/status" android:layout_width="1dp" android:layout_height="1dp"
        android:visibility="gone" />
</FrameLayout>
